    },
    "Discarding…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verworfen…"
          }
        }
      }
    },
    "Dismiss" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorieren"
          }
        }
      }
    },
    "Distributing to %lld people is a lot to manage — you'll need to exchange keys, approve every pickup, and keep track of all of them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verteilung an %lld Personen ist viel Verwaltungsaufwand — Sie müssen Schlüssel austauschen, jede Abholung genehmigen und den Überblick über alle behalten."
          }
        }
      }
    },
    "Distributing to %lld people is more holders than usual to keep track of." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verteilung an %lld Personen bedeutet mehr Inhaber als üblich, um den Überblick zu behalten."
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig"
          }
        }
      }
    },
    "e.g. BitLocker recovery key" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z. B. BitLocker-Wiederherstellungsschlüssel"
