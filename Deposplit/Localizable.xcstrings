            "value" : "Verifizierungsstufe"
          }
        }
      }
    },
    "Whether Premium is unlocked is decided on this device. The relay never learns anything about it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob Premium freigeschaltet ist, entscheidet dieses Gerät. Das Relais erfährt davon nichts."
