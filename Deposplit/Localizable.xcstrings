        }
      }
    },
    "Camera access is required to scan QR codes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für das Scannen von QR-Codes wird Kamerazugriff benötigt."
