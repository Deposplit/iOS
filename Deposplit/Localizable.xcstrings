    },
    "Confirm Relink" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuverknüpfung bestätigen"
          }
        }
      }
    },
    "Contacts" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakte"
          }
        }
      }
    },
    "Contacts, verification levels, and secret metadata only — never shares or private keys." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Kontakte, Verifizierungsstufen und Geheimnis-Metadaten — niemals Anteile oder private Schlüssel."
          }
        }
      }
    },
    "Copy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren"
          }
        }
      }
    },
    "Create new keys" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Schlüssel erzeugen"
          }
        }
      }
    },
    "Create new keys, then meet your contacts and let them scan your new code — both the people holding shares for you and the people whose shares you hold. Until they do, they cannot reach you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugen Sie neue Schlüssel und treffen Sie dann Ihre Kontakte, damit sie Ihren neuen Code scannen — sowohl die Personen, die Anteile für Sie halten, als auch die, deren Anteile Sie halten. Bis dahin können sie Sie nicht erreichen."
          }
        }
      }
    },
    "Default relay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard-Relais"
          }
        }
      }
    },
    "Denied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
