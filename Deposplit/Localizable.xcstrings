          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselungsschlüssel (base64url)"
          }
        }
      }
    },
    "Enrol a biometric (Face ID or Touch ID) in device settings to reconstruct the secret." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richten Sie in den Geräteeinstellungen eine biometrische Methode (Face ID oder Touch ID) ein, um das Geheimnis zu rekonstruieren."
          }
        }
      }
    },
    "Enter Keys Manually" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel manuell eingeben"
          }
        }
      }
    },
    "Enter secret text or …" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimen Text eingeben oder …"
          }
        }
      }
    },
    "Error" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler"
          }
        }
      }
    },
    "Error: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler: %@"
          }
        }
      }
    },
    "Every single holder must be available — if even one loses their share, this secret becomes unrecoverable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder einzelne Inhaber muss verfügbar sein — verliert auch nur einer seinen Anteil, wird dieses Geheimnis unwiederbringlich."
          }
        }
      }
    },
    "Excluded %lld inconsistent share(s) (from: %@). Reconstructed from the remaining consistent shares." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld inkonsistente(r) Anteil(e) ausgeschlossen (von: %2$@). Aus den verbleibenden konsistenten Anteilen rekonstruiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Excluded %1$lld inconsistent share(s) (from: %2$@). Reconstructed from the remaining consistent shares."
          }
        }
      }
    },
    "Export Catalog…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalog exportieren…"
