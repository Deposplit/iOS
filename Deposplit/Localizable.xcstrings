            "value" : "Genehmigt"
          }
        }
      }
    },
    "Are you sure?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher?"
          }
        }
      }
    },
    "As many secrets as you like" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beliebig viele Geheimnisse"
          }
        }
      }
    },
    "At least %lld holder(s) must cooperate to reconstruct the secret." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens %lld Inhaber müssen kooperieren, um das Geheimnis wiederherzustellen."
          }
        }
      }
    },
    "At least two contacts are needed first — a secret is split among at least two people" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst braucht es mindestens zwei Kontakte — ein Geheimnis wird unter mindestens zwei Personen aufgeteilt"
          }
        }
      }
    },
    "Authenticate to reconstruct your secret" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizieren Sie sich, um Ihr Geheimnis zu rekonstruieren"
          }
        }
      }
    },
    "Authentication failed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizierung fehlgeschlagen."
          }
        }
      }
    },
    "Biometric authentication is currently unavailable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrische Authentifizierung ist derzeit nicht verfügbar."
